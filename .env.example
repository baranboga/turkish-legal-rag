# Bu dosyayi ".env" olarak kopyalayip degerleri doldur:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# OpenAI - embedding uretimi (text-embedding-3-small)
OPENAI_API_KEY=

# Hugging Face Inference API - acik kaynak embedding modeli
HF_TOKEN=
# Dogrulama adiminda hangi modeli sectiysen onu yaz
HF_EMBEDDING_MODEL=
# Secilen modelin vektor boyutu (orn. 768)
HF_EMBEDDING_DIM=

# Pinecone - iki AYRI index gerekiyor, mevcut index'leri yeniden kullanma
PINECONE_API_KEY=
PINECONE_INDEX_OPENAI=turkish-legal-rag-openai-1536
PINECONE_INDEX_HF=turkish-legal-rag-hf

# Supabase Postgres
# Panel: Project Settings > Database > Connection string
# Migration icin direct connection (port 5432) kullan
DIRECT_URL=
# Uygulama sorgulari icin pooler (port 6543)
DATABASE_URL=
